# Local development only. Generate your own JWT_SECRET outside the demo.
DATABASE_URL=postgresql+psycopg://emaap:emaap_local@localhost:5432/emaap
JWT_SECRET=change-this-local-demo-secret-before-any-deployment-48chars
JWT_TTL_MINUTES=120
CORS_ORIGINS=http://localhost:3000
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=emaap-evidence
S3_ACCESS_KEY=emaap_local
S3_SECRET_KEY=emaap_local_storage_password
OCR_PROVIDER=paddle
# fixture only recognises byte-identical labelled seed assets. All other images abstain.
DEMO_MODE=true
VISION_FALLBACK_ENABLED=false
VISION_ENDPOINT=
VISION_API_KEY=
VISION_MODEL=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Physical phone: replace localhost with the computer's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000/api/v1

